# sudo cp tvlauncher.service /etc/systemd/system/ && sudo systemctl enable --now tvlauncher
[Unit]
Description=One-tap TV launcher
Wants=network-online.target
After=network-online.target

[Service]
User=pi
WorkingDirectory=/opt/tvlauncher
ExecStart=/opt/tvlauncher/.venv/bin/python launcher.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
